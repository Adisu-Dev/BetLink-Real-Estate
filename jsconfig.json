{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/src/*"]
    },
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "frontend/src/**/*",
    "frontend/src/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "frontend/node_modules",
    "backend/vendor",
    "frontend/dist"
  ]
}
